pipeline {

    agent any

    environment {
        IMAGE_NAME = "my-java-app"
        CONTAINER_NAME = "my-java-app"

        APP_SERVER = "ubuntu@YOUR_APP_SERVER_IP"

        RDS_HOST = "YOUR-RDS-ENDPOINT"
        RDS_PORT = "3306"
        RDS_DB   = "appdb"
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/YOUR_USERNAME/YOUR_REPO.git'
            }
        }

        stage('Build & Test') {
            steps {
                sh 'mvn clean test package'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t ${IMAGE_NAME}:latest .'
            }
        }

        stage('Copy Image') {
            steps {

                sshagent(['app-server-ssh']) {

                    sh '''
                        docker save ${IMAGE_NAME}:latest -o app.tar

                        scp -o StrictHostKeyChecking=no \
                            app.tar \
                            ${APP_SERVER}:/tmp/app.tar
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {

                sshagent(['app-server-ssh']) {

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'rds-credentials',
                            usernameVariable: 'DB_USER',
                            passwordVariable: 'DB_PASS'
                        )
                    ]) {

                        sh '''
                            ssh -o StrictHostKeyChecking=no ${APP_SERVER} "
                            
                            docker stop ${CONTAINER_NAME} || true
                            docker rm ${CONTAINER_NAME} || true

                            docker load -i /tmp/app.tar

                            docker run -d \
                                --name ${CONTAINER_NAME} \
                                -p 8080:8080 \
                                -e DB_URL=jdbc:mysql://${RDS_HOST}:${RDS_PORT}/${RDS_DB} \
                                -e DB_USER=${DB_USER} \
                                -e DB_PASS=${DB_PASS} \
                                ${IMAGE_NAME}:latest
                            "
                        }
                    }
                }
            }
        }
    }

    post {

        success {
            echo 'Deployment successful!'
        }

        failure {
            echo 'Deployment failed!'
        }
    }
}
